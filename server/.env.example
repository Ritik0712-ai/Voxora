# ---------------------------------------------------------------- Server
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed frontend origins, no trailing slashes.
FRONTEND_URL=http://localhost:5173

# Set to true to also allow https://<anything>.vercel.app preview deployments.
ALLOW_VERCEL_PREVIEWS=false

# Public origin of THIS server. Needed in production because req.protocol can
# report http behind a proxy, and browsers block mixed content on https pages.
# PUBLIC_URL=https://voxora-api.onrender.com

# ---------------------------------------------------------------- Database
# Use Neon's POOLED connection string (the host containing "-pooler").
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---------------------------------------------------------------- Auth
# Use a long random value in production: openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------- TTS
# edge   -> Microsoft Edge neural voices. No key, no billing. Default.
# mock   -> offline tone generator, for when there is no network.
# elevenlabs / google -> require keys; reseed voices to match.
TTS_PROVIDER=edge

GOOGLE_TTS_API_KEY=
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ---------------------------------------------------------------- Storage
# Without these, audio is written to local disk. That is fine locally, but on
# Render/Railway the disk is wiped on every restart and redeploy, so History
# playback breaks. Cloudflare R2 is free up to 10GB with no egress fees.
S3_BUCKET=
R2_ACCOUNT_ID=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
# S3_ENDPOINT=          # only if not using R2
# S3_REGION=auto
