# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# TTS Provider: "google" | "elevenlabs" | "mock"
#   mock  -> generates a real playable WAV locally, no API key or billing needed
#   google -> Google Cloud Text-to-Speech (matches the seeded voices table)
TTS_PROVIDER=mock

# Google Cloud TTS (console.cloud.google.com -> enable texttospeech.googleapis.com -> API key)
GOOGLE_TTS_API_KEY=

# ElevenLabs (alternative provider)
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
