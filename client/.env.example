# Vite inlines these at BUILD time, not runtime. Set it in the Vercel dashboard
# before deploying, or the built app will call localhost and every request fails.
# Must include the /api suffix and no trailing slash.
VITE_API_URL=http://localhost:5000/api

# Optional in production: builds fall back to the deployed API URL in
# src/api.js when this is unset, so a forgotten env var does not ship a bundle
# that calls localhost. Set it to point a build at a different API.
